# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
region            = "eu-north-1"
enable_middleware = true
mw_api_key        = "<your-middleware-api-key>"
mw_target         = "https://<uid>.middleware.io:443"
# allowed_cidr    = "203.0.113.10/32"   # defaults to your current public IP
